# Build output (regenerated by Visual Studio / dotnet build - never needed in git)
bin/
obj/
Content/bin/
Content/obj/

# MonoGame Content Builder intermediate/response files
*.mgstats

# IDE / editor / machine-specific files
.vs/
.vscode/
*.user
*.suo
*.DotSettings.user

# Local save data, if the game is ever run/debugged from inside the project folder
Saves/

# OS cruft
.DS_Store
Thumbs.db

# Legacy reference material only - NOT part of the live game and NOT this
# project's own source. These are raw dumps from the original Xbox 360
# build, kept locally purely for comparison while porting. Deliberately
# excluded from git regardless of repo visibility: this is the original
# game's material, not something this project should be redistributing on
# its own. If you're sure you want it in history anyway, just delete these
# two lines - nothing else depends on them being excluded.
originalFiles/
Claude Temp Here/

# Publish profile contains a machine-specific output path - not something to
# share/commit. Copy Properties/PublishProfiles/FolderProfile.pubxml.example
# to FolderProfile.pubxml and set your own PublishDir.
Properties/PublishProfiles/FolderProfile.pubxml
